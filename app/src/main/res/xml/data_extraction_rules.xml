<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: only the launcher preferences are backed up / transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="layernx_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="layernx_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
